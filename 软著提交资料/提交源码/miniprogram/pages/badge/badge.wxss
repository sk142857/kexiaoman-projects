.page {
  padding: 32rpx;
  background: #F5F6FA;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #F5A623, #F76B1C);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
}

.badge-item {
  width: 33.3%;
  text-align: center;
  margin-bottom: 40rpx;
}

.badge-icon {
  font-size: 64rpx;
}

.badge-on {
  color: #F5A623;
}

.badge-off {
  color: #ccc;
}

.badge-name {
  font-size: 26rpx;
  margin-top: 10rpx;
  font-weight: 600;
}

.badge-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.badge-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.loading {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
