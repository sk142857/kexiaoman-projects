<view class="page">
  <view class="card">
    <textarea
      class="note-input"
      placeholder="记录一下今天的完成情况…"
      value="{{note}}"
      bindinput="onNote"
      maxlength="500"
    ></textarea>
    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" bindtap="onPreview" data-index="{{index}}" />
        <view class="remove" catchtap="onRemove" data-index="{{index}}">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 9}}" bindtap="onChooseImage">＋</view>
    </view>
    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">提交打卡</button>
  </view>
</view>
