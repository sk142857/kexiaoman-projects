.page {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 200rpx);
}

/* ==================== 孩子卡片 ==================== */
.child-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  border: 2rpx solid transparent;
}
/* 默认已由性别后的 tag 提示，平时无边框；仅按中/选中时显示边框 */
.child-card:active {
  background: #f7f8fa;
  border-color: #2b6de0;
}
.child-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #c0c6cf;
  font-size: 32rpx;
}
.child-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #2b6de0 100%);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.child-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.child-name-row {
  display: flex;
  align-items: center;
}
.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.child-gender {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #8a919f;
  background: #f0f2f5;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.child-tag-default {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #2b6de0;
  background: #e6f4ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-weight: 600;
}
.child-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a919f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
}

/* ==================== 右下角悬浮按钮 ==================== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #2b6de0;
  color: #ffffff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 224, 0.4);
}

/* ==================== 底部操作菜单弹层 ==================== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  z-index: 1001;
}
.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  padding: 8rpx 40rpx 24rpx;
}
.sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 40rpx;
  border-top: 1rpx solid #f0f1f3;
}
.sheet-item:active {
  background: #f7f8fa;
}
.sheet-item-label {
  font-size: 30rpx;
  color: #1f2329;
}
.sheet-item-label--danger {
  color: #ff4d4f;
}
.sheet-cancel {
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 8rpx solid #f0f1f3;
  text-align: center;
  font-size: 30rpx;
  color: #8a919f;
}
