/* 统一空态：白色卡片 + 固定高度 + 居中 */
.empty {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.empty-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 48rpx 56rpx;
  text-align: center;
  box-sizing: border-box;
}
.empty-icon {
  font-size: 80rpx;
  line-height: 1.2;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 25rpx;
  color: #8a919f;
  line-height: 1.6;
}
