.tp {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tp-steps {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.tp-step {
  flex: 1;
  height: 100%;
  border-radius: 6rpx;
  background: #f0f1f3;
  overflow: hidden;
}
.tp-step-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.tp-text {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8a919f;
}
