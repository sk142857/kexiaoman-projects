<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="合集管理"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll" bindscrolltolower="onLoadMore" lower-threshold="120">
    <view class="page">
  <empty wx:if="{{list.length === 0}}" icon="📁" title="还没有合集" desc="点击下方 + 新建" />

  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="collection_id" class="item">
      <view class="info">
        <view class="name">
          <text class="no">#{{item.collection_id}}</text>{{item.name}}
        </view>
        <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
        <view class="count">📦 {{item.task_count}} 个任务</view>
      </view>
      <view class="del" wx:if="{{canManage}}" data-id="{{item.collection_id}}" bindtap="onDelete">删除</view>
    </view>
  </view>

  <view wx:if="{{list.length > 0 && !hasMore}}" class="list-foot">— 没有更多了 —</view>
  <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>

  <view wx:if="{{canManage}}" class="fab" bindtap="openCreate">＋</view>
  </view>
</scroll-view>

  <!-- 新建合集（主家长/家属/管理员/个人） -->
  <view wx:if="{{showCreate && canManage}}" class="mask">
    <view class="modal">
      <view class="modal-title">新建合集</view>
      <input class="modal-input" placeholder="合集名称" value="{{name}}" bindinput="onName" />
      <input class="modal-input" placeholder="合集描述（可选）" value="{{description}}" bindinput="onDesc" />
      <view class="modal-ops">
        <t-button class="modal-btn modal-btn--cancel" theme="default" variant="outline" block bindtap="closeCreate">取消</t-button>
        <t-button class="modal-btn modal-btn--submit" theme="primary" variant="base" block bindtap="submitCreate" loading="{{submitting}}">创建</t-button>
      </view>
    </view>
  </view>
</view>
