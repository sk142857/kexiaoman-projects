.page {
  /* 底部有 FAB：非 tab 页用 env 安全区，避免多余留白 */
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 128rpx);
}
.item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.info { flex: 1; margin-right: 16rpx; }
.name { font-size: 32rpx; font-weight: 600; }
.desc { margin-top: 8rpx; font-size: 26rpx; color: #8a919f; }
.count { margin-top: 12rpx; font-size: 24rpx; color: #2b6de0; }
.del { color: #ff4d4f; font-size: 26rpx; }
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2b6de0;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 224, 0.4);
}
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.modal-input {
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.modal-ops {
  display: flex;
  margin-top: 24rpx;
}
.modal-btn {
  flex: 1;
}
.modal-btn--cancel {
  margin-right: 16rpx;
}
