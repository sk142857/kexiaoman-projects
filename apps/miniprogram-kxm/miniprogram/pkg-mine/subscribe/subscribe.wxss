.sub-main {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.sub-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  margin-bottom: 24rpx;
}

/* ==================== 剩余次数 ==================== */
.sub-count {
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #2b6de0, #5a8cff);
}
.sub-count-num {
  font-size: 96rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}
.sub-count-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}
.sub-count-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ==================== 说明 ==================== */
.sub-desc {
  padding: 8rpx 32rpx;
}
.sub-desc-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
}
.sub-desc-row + .sub-desc-row {
  border-top: 1rpx solid #f0f1f3;
}
.sub-desc-key {
  font-size: 28rpx;
  color: #5c6470;
}
.sub-desc-val {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}
.sub-desc-val.warn {
  color: #e37318;
}
.sub-tip {
  padding: 20rpx 0 28rpx;
  font-size: 24rpx;
  color: #8a919f;
  line-height: 1.6;
}

/* ==================== 增加次数 ==================== */
.sub-cta {
  margin-bottom: 32rpx;
}
.sub-cta-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #e37318;
}

/* ==================== 授权记录 ==================== */
.sub-section-title {
  margin: 8rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #5c6470;
}
.sub-grants {
  padding: 8rpx 32rpx;
}
.sub-grant {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}
.sub-grant + .sub-grant {
  border-top: 1rpx solid #f0f1f3;
}
.sub-grant-left {
  flex: 1;
  min-width: 0;
}
.sub-grant-title {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sub-grant-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a919f;
}
.sub-grant-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sub-grant-used {
  font-size: 22rpx;
  color: #8a919f;
}
.sub-grant-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.sub-grant-status.ok {
  color: #16a87a;
  background: #e6faf4;
}
.sub-grant-status.off {
  color: #8a919f;
  background: #f0f1f3;
}

/* ==================== 加载态（卡片内占位） ==================== */
.sub-loading {
  height: 240rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #b0b6c0;
}
