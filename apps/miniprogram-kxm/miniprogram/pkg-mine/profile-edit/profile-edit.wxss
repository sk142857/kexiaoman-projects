/* ==================== 内容滚动区 ==================== */
.content {
  padding: 24rpx 32rpx 240rpx;
  box-sizing: border-box;
}

/* ==================== 头像 ==================== */
.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}
.avatar-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2b6de0, #5a8cff);
  overflow: hidden;
  line-height: 1;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn--active {
  opacity: 0.85;
}
.avatar-img {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
}
.avatar-char {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
}
.avatar-cam {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8a919f;
}

/* ==================== 表单 ==================== */
.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
  padding: 8rpx 0;
}
.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  color: #1f2329;
  padding: 0 24rpx;
}
.ph {
  color: #b0b6c0;
}
.value-box {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #f7f8fa;
  font-size: 30rpx;
  color: #8a919f;
  padding: 0 24rpx;
}

/* ==================== 底部操作栏（flex 子项贴底，见规范 §3.1，skyline 下不用 fixed） ==================== */
.footer {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.footer t-button {
  flex: 1;
}
