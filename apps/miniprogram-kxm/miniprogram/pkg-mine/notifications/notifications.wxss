.page {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

/* ==================== 顶部栏 ==================== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.toolbar-tip {
  font-size: 24rpx;
  color: #8a919f;
}
.read-all {
  font-size: 26rpx;
  color: #2b6de0;
  padding: 8rpx 16rpx;
}
.read-all:active {
  opacity: 0.7;
}

/* ==================== 通知列表（独立卡片，卡片间有间距；左边框色随业务场景） ==================== */
.n-item {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.n-item--active {
  background: rgba(31, 35, 41, 0.03);
}
.n-bar {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.n-body {
  flex: 1;
  min-width: 0;
}
.n-head {
  display: flex;
  align-items: center;
  min-width: 0;
}
.n-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.n-type {
  flex-shrink: 0;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}
.n-status {
  flex-shrink: 0;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}
.n-status--read {
  color: #8a919f;
  background: #f2f3f5;
}
.n-status--unread {
  color: #f6685d;
  background: #fdeeed;
  font-weight: 600;
}
.n-content {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5c6470;
  word-break: break-all;
}
.n-item--read .n-content {
  color: #8a919f;
}
.n-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}
.n-time {
  font-size: 22rpx;
  color: #b0b6c0;
}

/* ==================== 底部 ==================== */
.n-foot {
  margin-top: 8rpx;
  padding: 16rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
}
