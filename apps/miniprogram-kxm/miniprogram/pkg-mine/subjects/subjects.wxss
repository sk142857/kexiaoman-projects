.page {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 128rpx);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.color-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e5e7eb;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
}
.name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
}
.ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2b6de0;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 224, 0.4);
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.modal {
  width: 640rpx;
  max-height: 78vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.field-label {
  font-size: 26rpx;
  color: #8a919f;
  margin: 16rpx 0 12rpx;
}
.modal-input {
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.preset-wrap {
  margin-bottom: 8rpx;
}
.preset-label {
  font-size: 24rpx;
  color: #8a919f;
  margin-bottom: 12rpx;
}
.preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.preset-chip {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}
.preset-chip--active {
  color: #2b6de0;
  background: #eef4ff;
  border-color: #2b6de0;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.color-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #8a919f;
}
.color-item--active {
  border-color: #2b6de0;
}

.modal-ops {
  display: flex;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
}
.modal-btn--cancel {
  margin-right: 16rpx;
}
