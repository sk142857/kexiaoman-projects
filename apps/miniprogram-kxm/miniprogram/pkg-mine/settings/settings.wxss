.page {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
}
.menu-item:active {
  background: rgba(31, 35, 41, 0.03);
}
.menu-item + .menu-item {
  border-top: 1rpx solid #f0f1f3;
}
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-icon--blue { background: #e6f4ff; }
.menu-icon--green { background: #e6faf4; }
.menu-icon--rose { background: #fff1f0; }
.menu-icon--amber { background: #fff7e6; }
.menu-icon--purple { background: #f5f0ff; }
.menu-icon--gray { background: #f2f3f5; }
.menu-icon--danger { background: #fff1f0; }
.menu-item--danger .menu-label { color: #d54941; }
.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}
.menu-value {
  font-size: 24rpx;
  color: #8a919f;
}
.menu-label-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.menu-desc {
  font-size: 22rpx;
  color: #8a919f;
}
.menu-arrow {
  font-size: 44rpx;
  font-weight: 700;
  color: #b0b6c0;
}

/* 未读通知徽标：包一层 view，避免 Skyline 下自定义组件作为 flex 子项时垂直居中失效 */
.menu-notify-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}
.menu-notify-badge .notify-badge {
  align-items: center;
}
.identity-status {
  font-size: 24rpx;
  color: #8a919f;
  margin-right: 12rpx;
}
.identity-status--on {
  color: #2b6de0;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}
