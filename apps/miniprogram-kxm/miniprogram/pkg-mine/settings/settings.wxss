.page {
  padding: 24rpx 32rpx calc(var(--safe-bottom) + 32rpx);
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
}
.menu-item:active {
  background: rgba(31, 35, 41, 0.03);
}
.menu-item + .menu-item {
  border-top: 1rpx solid #f0f1f3;
}
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-icon--blue { background: #e6f4ff; }
.menu-icon--green { background: #e6faf4; }
.menu-icon--rose { background: #fff1f0; }
.menu-icon--amber { background: #fff7e6; }
.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}
.menu-label-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.menu-desc {
  font-size: 22rpx;
  color: #8a919f;
}
.menu-arrow {
  font-size: 32rpx;
  color: #b0b6c0;
}
.identity-status {
  font-size: 24rpx;
  color: #8a919f;
  margin-right: 12rpx;
}
.identity-status--on {
  color: #2b6de0;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}
