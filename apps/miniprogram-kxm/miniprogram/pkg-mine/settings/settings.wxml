<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="设置"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll">
    <view class="page">
      <view class="menu-card">
        <view wx:if="{{isParent}}" class="menu-item" bindtap="goBackendAccount">
          <view class="menu-icon menu-icon--blue">🔐</view>
          <text class="menu-label">后台账号</text>
          <text class="menu-arrow">›</text>
        </view>
        <view wx:if="{{isParent}}" class="menu-item" bindtap="onPin">
          <view class="menu-icon menu-icon--amber">🛡️</view>
          <view class="menu-label-col">
            <text class="menu-label">身份保护</text>
            <text class="menu-desc">孩子切换家长身份需 PIN 锁</text>
          </view>
          <text class="identity-status {{pinEnabled ? 'identity-status--on' : ''}}">{{pinEnabled ? '已开启' : '未开启'}}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view wx:if="{{isParent}}" class="menu-item" bindtap="goShares">
          <view class="menu-icon menu-icon--purple">🤝</view>
          <text class="menu-label">家属共享</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goSubscribe">
          <view class="menu-icon menu-icon--green">🔔</view>
          <text class="menu-label">订阅消息</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goNotifications">
          <view class="menu-icon menu-icon--purple">📣</view>
          <text class="menu-label">系统通知</text>
          <text wx:if="{{notifyUnread > 0}}" class="notify-badge">{{notifyUnread > 99 ? '99+' : notifyUnread}}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onRebind">
          <view class="menu-icon menu-icon--rose">🔑</view>
          <text class="menu-label">重新绑定</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="foot">课小满 · 设置</view>
    </view>
  </scroll-view>
</view>
