.page {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.tip-card {
  background: #eef4ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.tip-text {
  font-size: 26rpx;
  color: #4a6fb5;
  line-height: 1.6;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
}
.menu-item:active {
  background: rgba(31, 35, 41, 0.03);
}
.menu-item + .menu-item {
  border-top: 1rpx solid #f0f1f3;
}
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-icon--cyan { background: #e6fffb; }
.menu-icon--green { background: #e6faf4; }
.menu-label-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.menu-label {
  font-size: 28rpx;
  color: #1f2329;
}
.menu-desc {
  font-size: 22rpx;
  color: #8a919f;
}
.menu-tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  margin-right: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #2b6de0;
  background: #eef4ff;
  border-radius: 999rpx;
}
.menu-arrow {
  font-size: 44rpx;
  font-weight: 700;
  color: #b0b6c0;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}
