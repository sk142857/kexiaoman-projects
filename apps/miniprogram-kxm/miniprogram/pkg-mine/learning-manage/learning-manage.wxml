<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="学习管理"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll">
    <view class="page">
      <view class="tip-card">
        <text class="tip-text">管理任务合集与科目。合集用于给任务分类归档；科目用于给任务打标签，创建任务前需先设置科目。</text>
      </view>

      <view class="menu-card">
        <view class="menu-item" bindtap="goCollections">
          <view class="menu-icon menu-icon--cyan">📁</view>
          <view class="menu-label-col">
            <text class="menu-label">合集管理</text>
            <text class="menu-desc">{{collectionCount}} 个合集 · 给任务分类归档</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goSubjects">
          <view class="menu-icon menu-icon--green">📚</view>
          <view class="menu-label-col">
            <text class="menu-label">科目管理</text>
            <text class="menu-desc">{{subjectCount}} 个科目 · 创建任务前先设置科目</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="foot">课小满 · 学习管理</view>
    </view>
  </scroll-view>
</view>
