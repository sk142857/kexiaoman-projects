.header {
  flex-shrink: 0;
  background: linear-gradient(180deg, #eaf2ff 0%, #eef4ff 100%);
  --td-navbar-background: transparent;
}
.steps-band {
  padding: 56rpx 48rpx 40rpx;
}
.steps {
  width: 100%;
}

.content {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.form {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
  padding: 8rpx 0;
}
.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.req {
  color: #ff4d4f;
}

/* 统一有边框输入框 */
.input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  color: #1f2329;
  padding: 0 24rpx;
}
.ph {
  color: #b0b6c0;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1f2329;
  padding: 20rpx 24rpx;
}
.title-textarea {
  min-height: 140rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.desc-textarea {
  min-height: 320rpx;
}

/* 选择器（带边框） */
.picker-box {
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 500;
}
.picker-box text:first-child {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-box.is-ph text:first-child {
  color: #b0b6c0;
  font-weight: 400;
}
.arrow {
  margin-left: 16rpx;
  color: #b0b6c0;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.tag-input-row {
  display: flex;
  gap: 16rpx;
}
.tag-input {
  flex: 1;
}
.tag-add {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  background: #2b6de0;
  color: #ffffff;
  border-radius: 16rpx;
  text-align: center;
}
.tag-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  background: #eef4ff;
  color: #2b6de0;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}
.tag-x {
  opacity: 0.7;
}

.assignee-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.assignee {
  background: #ffffff;
  border: 2rpx solid #d8dce3;
  color: #5c6470;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
.assignee.on {
  background: #eef4ff;
  border-color: #2b6de0;
  color: #2b6de0;
  font-weight: 600;
}
.hint {
  font-size: 24rpx;
  color: #b0b6c0;
}
.checkin-type-desc {
  font-size: 24rpx;
  color: #b0b6c0;
  margin-top: 10rpx;
}

/* ==================== 底部操作栏（flex 子项贴底，见规范 §3.1，skyline 下不用 fixed） ==================== */
.footer {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.footer t-button {
  flex: 1;
}
.footer-row {
  display: flex;
  width: 100%;
  gap: 24rpx;
}
.footer-prev {
  flex-shrink: 0;
}
.footer-prev t-button {
  width: 200rpx;
}
.footer-main {
  flex: 1;
  min-width: 0;
}
.footer-main t-button {
  width: 100%;
}

/* ==================== 步骤五：确认保存预览 ==================== */
.preview-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.preview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.preview-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  word-break: break-all;
}
.preview-subject {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2b6de0;
  background: #eef4ff;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.preview-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}
.preview-row:last-of-type {
  border-bottom: none;
}
.preview-label {
  flex-shrink: 0;
  width: 120rpx;   /* 容纳 4 字 label（如 打卡方式/归属合集），避免换行 */
  font-size: 26rpx;
  color: #8a919f;
  white-space: nowrap;
}
.preview-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2329;
  word-break: break-all;
}
.preview-desc {
  white-space: pre-wrap;
}
.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.preview-tag {
  background: #eef4ff;
  color: #2b6de0;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  font-size: 24rpx;
}
.preview-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.preview-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}
