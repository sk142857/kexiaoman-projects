<view class="lp-page">
  <view class="header">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="{{clone ? '克隆任务' : (editing ? '编辑任务' : '新增任务')}}"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
    <view class="steps-band">
      <t-steps class="steps" current="{{step}}" readonly>
        <t-step-item title="标题" />
        <t-step-item title="时间" />
        <t-step-item title="设置" />
        <t-step-item title="描述" />
        <t-step-item title="确认" />
      </t-steps>
    </view>
  </view>

  <!-- 步骤一：标题与科目 -->
  <scroll-view wx:if="{{step === 0}}" scroll-y class="lp-scroll content">
    <view class="form">
      <view class="field">
        <view class="label">任务标题 <text class="req">*</text></view>        <textarea
          class="textarea title-textarea"
          placeholder="请输入任务标题（最长 100 字）"
          placeholder-class="ph"
          value="{{title}}"
          bindinput="onTitle"
          maxlength="100"
        />
      </view>

      <view class="field">
        <view class="label">科目 <text class="req">*</text></view>
        <picker mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="onSubject">
          <view class="picker-box {{subject ? '' : 'is-ph'}}">
            <text>{{subject || '请选择科目'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </scroll-view>

  <!-- 步骤二：时间安排 -->
  <scroll-view wx:if="{{step === 1}}" scroll-y class="lp-scroll content">
    <view class="form">
      <view class="field">
        <view class="label">开始日期</view>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
          <view class="picker-box {{startDate ? '' : 'is-ph'}}">
            <text>{{startDate || '选择开始日期'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="label">截止日期</view>
        <picker mode="date" value="{{deadline}}" bindchange="onDeadline">
          <view class="picker-box {{deadline ? '' : 'is-ph'}}">
            <text>{{deadline || '选择截止日期'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="label">合集</view>
        <picker range="{{collections}}" range-key="name" value="{{collectionIndex}}" bindchange="onCollection">
          <view class="picker-box {{collectionIndex >= 0 ? '' : 'is-ph'}}">
            <text>{{collectionIndex >= 0 ? collections[collectionIndex].name : '不选择合集'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </scroll-view>

  <!-- 步骤三：更多设置 -->
  <scroll-view wx:if="{{step === 2}}" scroll-y class="lp-scroll content">
    <view class="form">
      <view class="field">
        <view class="label">标签</view>
        <view class="tag-input-row">
          <input class="input tag-input" placeholder="输入标签，点击添加" placeholder-class="ph" value="{{tagText}}" bindinput="onTagInput" confirm-type="done" bindconfirm="addTag" />
          <view class="tag-add" bindtap="addTag">添加</view>
        </view>
        <view wx:if="{{tags.length}}" class="tag-list">
          <view wx:for="{{tags}}" wx:key="index" class="tag" data-index="{{index}}" bindtap="removeTag">#{{item}}<text class="tag-x"> ✕</text></view>
        </view>
      </view>

      <view class="field">
        <view class="label">任务图片（最多 9 张）</view>
        <t-upload
          files="{{files}}"
          max="{{9}}"
          media-type="{{['image']}}"
          grid-config="{{uploadGrid}}"
          config="{{uploadConfig}}"
          remove-btn="{{true}}"
          bind:add="handleUploadAdd"
          bind:remove="handleUploadRemove"
        />
      </view>

      <view class="field">
        <view class="label">打卡方式</view>
        <picker mode="selector" range="{{checkinTypeOptions}}" range-key="label" value="{{checkinTypeIndex}}" bindchange="onCheckinType">
          <view class="picker-box">
            <text>{{checkinTypeOptions[checkinTypeIndex].label}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
        <view class="checkin-type-desc">{{checkinTypeOptions[checkinTypeIndex].desc}}</view>
      </view>

      <view wx:if="{{isManager}}" class="field">
        <view class="label">派发给学生 <text class="req">*</text></view>
        <view class="assignee-list">
          <view
            wx:for="{{students}}"
            wx:key="staff_id"
            class="assignee {{assigneeMap[item.staff_id] ? 'on' : ''}}"
            data-id="{{item.staff_id}}"
            bindtap="toggleAssignee"
          >{{item.nickname}}</view>
          <view wx:if="{{students.length === 0}}" class="hint">暂无学生账号，请联系管理员创建学生后再派发</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 步骤四：任务描述 -->
  <scroll-view wx:if="{{step === 3}}" scroll-y class="lp-scroll content">
    <view class="form">
      <view class="field">
        <view class="label">任务描述</view>
        <textarea
          class="textarea desc-textarea"
          placeholder="请输入任务描述，可补充任务要求、注意事项等（选填）"
          placeholder-class="ph"
          value="{{description}}"
          bindinput="onDesc"
          maxlength="500"
        />
      </view>
    </view>
  </scroll-view>

  <!-- 步骤五：确认保存（预览） -->
  <scroll-view wx:if="{{step === 4}}" scroll-y class="lp-scroll content">
    <view class="preview-card">
      <view class="preview-head">
        <view class="preview-title">{{title}}</view>
        <view class="preview-subject">{{subject}}</view>
      </view>
      <view class="preview-row">
        <text class="preview-label">时间</text>
        <text class="preview-value">{{startDate || '—'}} ~ {{deadline || '—'}}</text>
      </view>
      <view wx:if="{{collectionIndex >= 0 && collections[collectionIndex]}}" class="preview-row">
        <text class="preview-label">合集</text>
        <text class="preview-value">{{collections[collectionIndex].name}}</text>
      </view>
      <view wx:if="{{tags.length}}" class="preview-row">
        <text class="preview-label">标签</text>
        <view class="preview-tags">
          <text wx:for="{{tags}}" wx:key="index" class="preview-tag">#{{item}}</text>
        </view>
      </view>
      <view wx:if="{{description}}" class="preview-row">
        <text class="preview-label">描述</text>
        <text class="preview-value preview-desc">{{description}}</text>
      </view>
      <view wx:if="{{isManager}}" class="preview-row">
        <text class="preview-label">派发</text>
        <text class="preview-value">{{assigneeIds.length ? assigneeNames : '未选择'}}</text>
      </view>
      <view wx:if="{{previewImages.length}}" class="preview-row">
        <text class="preview-label">图片</text>
        <view class="preview-imgs">
          <image wx:for="{{previewImages}}" wx:key="index" class="preview-img" src="{{item}}" mode="aspectFill" bindtap="preview" data-index="{{index}}" />
        </view>
      </view>
    </view>
    <view class="preview-tip">请核对任务信息，确认无误后点击下方按钮保存</view>
  </scroll-view>

  <!-- 固定底部操作栏 -->
  <view class="footer">
    <block wx:if="{{step === 0}}">
      <t-button class="btn" theme="primary" block bindtap="onNext">下一步</t-button>
    </block>

    <block wx:elif="{{step === 1}}">
      <view class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="onPrev">上一步</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onNext">下一步</t-button>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 2}}">
      <view class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="onPrev">上一步</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onNext">下一步</t-button>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 3}}">
      <view class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="onPrev">上一步</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onNext">下一步</t-button>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 4}}">
      <view class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="onPrev">上一步</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onSubmit" loading="{{submitting}}">{{clone ? '确认克隆' : (editing ? '确认保存' : '确认创建')}}</t-button>
        </view>
      </view>
    </block>
  </view>
</view>
