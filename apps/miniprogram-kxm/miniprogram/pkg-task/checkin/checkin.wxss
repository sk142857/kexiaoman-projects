.header {
  flex-shrink: 0;
  background: linear-gradient(180deg, #eaf2ff 0%, #eef4ff 100%);
  --td-navbar-background: transparent;
}
.steps-band {
  padding: 48rpx 48rpx 40rpx;
}
.task-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.steps {
  width: 100%;
}

.content {
  padding: 24rpx 32rpx 240rpx;
  box-sizing: border-box;
}
.form {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
  padding: 8rpx 0;
}
.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 统一有边框输入框 */
.picker-box {
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 500;
}
.picker-box text:first-child {
  flex: 1;
}
.arrow {
  margin-left: 16rpx;
  color: #c9cdd4;
  font-size: 36rpx;
  line-height: 1;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1f2329;
  padding: 20rpx 24rpx;
}
.ph {
  color: #b0b6c0;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.img.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #b0b6c0;
  border: 2rpx dashed #d8dce3;
  background: #fafbfc;
}

/* ==================== 语音打卡 ==================== */
.voice-box {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.voice-tip {
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 56rpx;
}
.mic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4c8dff, #2b6de0);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(43, 109, 224, 0.3);
}
.mic.recording {
  background: linear-gradient(135deg, #ff8a5c, #f2614e);
  box-shadow: 0 12rpx 30rpx rgba(242, 97, 78, 0.3);
}
.mic-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 麦克风图标：筒体 + U型托架 + 支架（纯视图绘制，Skyline 不支持伪元素） */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mic-body {
  width: 56rpx;
  height: 84rpx;
  background: #ffffff;
  border-radius: 28rpx;
}
.mic-arc {
  width: 44rpx;
  height: 26rpx;
  border: 8rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 44rpx 44rpx;
  box-sizing: border-box;
  margin-top: -2rpx;
}
.mic-stand {
  width: 8rpx;
  height: 40rpx;
  background: #ffffff;
  border-radius: 4rpx;
  margin-top: 6rpx;
}
/* 录音中：红点 + 声波 */
.rec-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  margin-bottom: 12rpx;
}
.rec-wave {
  width: 120rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 8rpx;
}
/* 已录音：对勾 */
.done-check {
  font-size: 96rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}
.voice-state {
  margin-top: 40rpx;
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 500;
}
.voice-timer {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #f2614e;
}
.voice-ops {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}
.voice-op {
  min-width: 180rpx;
}

/* ==================== 视频打卡 ==================== */
.video-box {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.video-tip {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
  word-break: break-all;
}
.video-preview {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.video-preview .video {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #1f2329;
}
.video-meta {
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a919f;
  text-align: center;
  line-height: 1.5;
  word-break: break-all;
}
.video-empty {
  width: 100%;
  height: 320rpx;
  border: 2rpx dashed #d8dce3;
  border-radius: 16rpx;
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.video-plus {
  font-size: 72rpx;
  color: #b0b6c0;
  line-height: 1;
}
.video-empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #8a919f;
}

/* ==================== 底部操作栏（flex 子项贴底，见规范 §3.1，skyline 下不用 fixed） ==================== */
.footer {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.footer t-button {
  flex: 1;
}
.footer-row {
  display: flex;
  width: 100%;
  gap: 24rpx;
}
.footer-prev {
  flex-shrink: 0;
}
.footer-prev t-button {
  width: 200rpx;
}
.footer-main {
  flex: 1;
  min-width: 0;
}
.footer-main t-button {
  width: 100%;
}
