<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="任务详情"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll">
    <view class="page">
  <empty wx:if="{{!task}}" icon="📭" title="暂无任务数据" />

  <block wx:elif="{{task}}">
    <!-- 任务信息 -->
    <view class="card">
      <view class="card-head">
        <view class="title">{{task.title}}</view>
        <view class="status">
          <t-tag size="small" shape="round" theme="{{taskStatusTheme}}">{{taskStatusText}}</t-tag>
        </view>
      </view>
      <view class="meta">
        <t-tag wx:if="{{task.subject}}" class="tag-gap" size="small" variant="light" theme="primary">{{task.subject}}</t-tag>
        <t-tag wx:if="{{task.collection_name}}" class="tag-gap" size="small" variant="outline" theme="default">{{task.collection_name}}</t-tag>
        <t-tag wx:if="{{taskSecBadge}}" class="tag-gap" size="small" variant="light" theme="{{taskSecTagTheme}}">{{taskSecBadge}}</t-tag>
        <t-tag class="tag-gap" size="small" shape="round" style="{{checkinTypeStyle}}">{{checkinTypeText}}</t-tag>
        <t-tag wx:if="{{task.score > 0}}" class="tag-gap" size="small" variant="light" theme="{{task.score >= 5 ? 'success' : 'warning'}}">评分 {{task.score}}分</t-tag>
      </view>
      <view class="task-progress">
        <task-progress percent="{{task.progress}}" height="16" />
      </view>
      <view wx:if="{{task.description}}" class="desc">{{task.description}}</view>
      <view wx:if="{{task.tags && task.tags.length}}" class="tags">
        <t-tag wx:for="{{task.tags}}" wx:key="index" class="tag-gap" size="small" variant="outline" theme="default">#{{item}}</t-tag>
      </view>
      <view wx:if="{{images.length}}" class="imgs">
        <view wx:for="{{images}}" wx:key="index" class="img-wrap">
          <image class="img {{taskImageStates[index] === 'reviewing' ? 'img--locked' : ''}}" src="{{item}}" mode="aspectFill" lazy-load bindtap="preview" data-url="{{item}}" data-index="{{index}}" />
          <view wx:if="{{taskImageStates[index] === 'reviewing'}}" class="img-lock">
            <view class="img-lock-icon">🔒</view>
            <view class="img-lock-text">安全审核中</view>
          </view>
        </view>
      </view>
      <view wx:if="{{creatorName && createdTime}}" class="created-info">
        <image wx:if="{{creatorAvatar}}" class="creator-avatar" src="{{creatorAvatar}}" mode="aspectFill" />
        <view wx:else class="creator-avatar creator-avatar--char">{{creatorChar}}</view>
        <text class="created-text">{{creatorText}}</text>
      </view>
      <view class="foot">
        <text class="foot-checkin">打卡 {{task.checkin_count}} 次</text>
        <text wx:if="{{task.deadline}}" class="foot-deadline" style="color: {{isDone ? '#b0b6c0' : '#f6685d'}};">截止 {{task.deadline}}</text>
      </view>
    </view>

    <!-- 打卡记录 -->
    <view class="ck-sec">
      <view class="section-title">
        <view class="section-title-main">
          <text class="section-title-icon">📝</text>
          <text>打卡记录</text>
        </view>
        <text class="section-title-count">共 {{checkins.length}} 次</text>
      </view>

      <empty wx:if="{{checkins.length === 0}}" icon="📊" title="还没有打卡" desc="完成任务后提交打卡即可展示" />

      <view wx:for="{{checkins}}" wx:key="checkin_id" class="ck-card">
        <view class="ck-accent"></view>
        <view class="ck-head">
          <view class="ck-date">
            <text class="ck-day">{{item.dateDay}}</text>
            <view class="ck-date-sub">
              <text class="ck-month">{{item.dateMonth}}</text>
              <text class="ck-week">{{item.dateWeek}}</text>
            </view>
          </view>
          <view class="ck-head-right">
            <view class="ck-status" style="color: {{item.reviewColor}}; background: {{item.reviewBg}};">{{item.reviewText}}</view>
            <view wx:if="{{item.secBadge}}" class="ck-sec-badge" style="color: {{item.secColor}}; background: {{item.secBg}};">{{item.secBadge}}</view>
            <view wx:if="{{item.scoreText}}" class="ck-score">{{item.scoreText}}</view>
            <view wx:if="{{item.canDelete}}" class="ck-del" bindtap="onDeleteCheckin" data-id="{{item.checkin_id}}"><t-icon name="delete" size="36rpx" /></view>
          </view>
        </view>

        <view wx:if="{{item.masked}}" class="ck-masked">🔒 {{item.maskText}}</view>

        <view wx:if="{{item.checkin_type === 'video' && item.videoUrl}}" class="ck-media">
          <video class="video" src="{{item.videoUrl}}" controls objectFit="contain" poster="{{item.videoCover}}" />
          <view wx:if="{{item.video_duration}}" class="ck-media-meta">{{item.mediaText}} · 时长 {{item.video_duration}} 秒</view>
        </view>
        <view wx:elif="{{item.checkin_type === 'voice' && item.voiceUrl}}" class="ck-media">
          <voice-player src="{{item.voiceUrl}}" duration="{{item.voice_duration}}" />
          <view class="ck-media-meta">{{item.mediaText}}</view>
        </view>
        <view wx:elif="{{item.images.length}}" class="ck-media">
          <view class="ck-imgs">
            <view wx:for="{{item.images}}" wx:for-item="img" wx:for-index="i" wx:key="index" class="ck-img-wrap">
              <image class="ck-img {{item.imageStates[i] === 'reviewing' ? 'ck-img--locked' : ''}}" src="{{img}}" mode="aspectFill" lazy-load data-index="{{i}}" data-cid="{{item.checkin_id}}" bindtap="previewCheckin" />
              <view wx:if="{{item.imageStates[i] === 'reviewing'}}" class="ck-img-lock">
                <view class="ck-img-lock-icon">🔒</view>
                <view class="ck-img-lock-text">安全审核中</view>
              </view>
              <view wx:if="{{i === 8 && item.totalImages > 9}}" class="ck-img-more">+{{item.totalImages - 9}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.checkin_note}}" class="ck-note">{{item.checkin_note}}</view>

        <view wx:if="{{item.review_note}}" class="ck-review">
          <view class="ck-review-dot" style="background: {{item.reviewColor}};"></view>
          <view class="ck-review-body">
            <text class="ck-review-label" style="color: {{item.reviewColor}};">{{item.reviewLabel}}</text>
            <text class="ck-review-text">{{item.review_note}}</text>
          </view>
        </view>

        <view class="ck-foot">
          <view class="ck-submitter">
            <image wx:if="{{item.submitter_avatar}}" class="ck-submitter-avatar" src="{{item.submitter_avatar}}" mode="aspectFill" />
            <view wx:else class="ck-submitter-avatar ck-submitter-avatar--char">{{item.submitter_initial}}</view>
            <text class="ck-time">{{item.submitter_name}} 于 {{item.submitTime}}{{item.sourceText ? ' ' + item.sourceText + '提交' : ' 提交'}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
  </view>
</scroll-view>

  <!-- 底部操作栏：开始/完成/打卡/编辑/删除/复制 一律贴底，页面中间不放按钮 -->
  <view wx:if="{{task && (canCheckin || canManage || canCopy)}}" class="lp-actions">
    <t-button wx:if="{{canCheckin && task.task_status === 'doing'}}" class="act-finish" theme="default" variant="outline" block bindtap="onFinish">完成任务</t-button>
    <t-button wx:if="{{canCheckin && task.task_status !== 'done'}}" class="act-checkin" theme="primary" variant="base" block bindtap="onCheckin">打卡</t-button>
    <t-button wx:if="{{canCopy}}" class="act-copy" theme="default" variant="outline" block bindtap="onCopy">克隆任务</t-button>
    <t-button wx:if="{{canManage}}" class="act-edit" theme="default" variant="outline" block bindtap="onEdit">编辑</t-button>
    <t-button wx:if="{{canManage}}" class="act-delete" theme="danger" variant="outline" block bindtap="onDelete">删除任务</t-button>
  </view>
</view>
