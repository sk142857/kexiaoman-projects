<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="任务详情"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y class="lp-scroll">
    <view class="page">
  <empty wx:if="{{!task}}" icon="📭" title="暂无任务数据" />

  <block wx:elif="{{task}}">
    <!-- 任务信息 -->
    <view class="card">
      <view class="card-head">
        <view class="title">{{task.title}}</view>
        <view class="status">
          <t-tag size="small" theme="{{task.task_status === 'todo' ? 'danger' : task.task_status === 'doing' ? 'primary' : 'success'}}" variant="light">
            {{task.task_status === 'todo' ? '待完成' : task.task_status === 'doing' ? '进行中' : '已完成'}}
          </t-tag>
        </view>
      </view>
      <view class="meta">
        <t-tag wx:if="{{task.subject}}" class="tag-gap" size="small" variant="light" theme="primary">{{task.subject}}</t-tag>
        <t-tag wx:if="{{task.collection_name}}" class="tag-gap" size="small" variant="outline" theme="default">{{task.collection_name}}</t-tag>
        <t-tag wx:if="{{checkinType === 'voice'}}" class="tag-gap" size="small" variant="light" theme="warning">语音打卡</t-tag>
        <t-tag wx:elif="{{checkinType === 'video'}}" class="tag-gap" size="small" variant="light" theme="primary">视频打卡</t-tag>
        <t-tag wx:elif="{{checkinType === 'image'}}" class="tag-gap" size="small" variant="outline" theme="default">图文打卡</t-tag>
        <t-tag wx:if="{{task.deadline}}" class="tag-gap" size="small" variant="light" theme="warning">截止 {{task.deadline}}</t-tag>
        <t-tag wx:if="{{task.score > 0}}" class="tag-gap" size="small" variant="light" theme="{{task.score >= 5 ? 'success' : 'warning'}}">评分 {{task.score}}分</t-tag>
      </view>
      <view class="task-progress">
        <task-progress percent="{{task.progress}}" height="16" />
      </view>
      <view wx:if="{{task.description}}" class="desc">{{task.description}}</view>
      <view wx:if="{{task.tags && task.tags.length}}" class="tags">
        <t-tag wx:for="{{task.tags}}" wx:key="index" class="tag-gap" size="small" variant="outline" theme="default">#{{item}}</t-tag>
      </view>
      <view wx:if="{{images.length}}" class="imgs">
        <image wx:for="{{images}}" wx:key="index" class="img" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}" />
      </view>
      <view wx:if="{{task.creator_name || task.created_at}}" class="created-info">
        <text wx:if="{{task.creator_name}}" class="created-text">创建人：{{task.creator_name}}</text>
        <text wx:if="{{task.created_at}}" class="created-text">创建于 {{task.created_at}}</text>
      </view>
      <view class="foot">打卡 {{task.checkin_count}} 次</view>
    </view>

    <!-- 打卡记录 -->
    <view class="section-title">打卡记录</view>
    <empty wx:if="{{checkins.length === 0}}" icon="📊" title="还没有打卡" desc="完成任务后提交打卡即可展示" />
      <view wx:for="{{checkins}}" wx:key="checkin_id" class="checkin">
        <view class="checkin-head">
          <text class="checkin-date">{{item.checkin_date}}</text>
          <view class="checkin-head-right">
            <text class="checkin-status" style="color: {{item.reviewColor}}; background: {{item.reviewBg}};">{{item.reviewText}}</text>
            <text wx:if="{{item.canDelete}}" class="del" bindtap="onDeleteCheckin" data-id="{{item.checkin_id}}">删除</text>
          </view>
        </view>
        <view wx:if="{{item.checkin_note}}" class="checkin-note">{{item.checkin_note}}</view>
        <view wx:if="{{item.review_note}}" class="checkin-review">审核说明：{{item.review_note}}</view>
        <view wx:if="{{item.checkin_type === 'video' && item.videoUrl}}" class="checkin-video">
          <video class="video" src="{{item.videoUrl}}" controls objectFit="contain" poster="{{item.videoCover}}" />
          <view wx:if="{{item.video_duration}}" class="checkin-video-meta">时长 {{item.video_duration}} 秒</view>
        </view>
        <view wx:elif="{{item.checkin_type === 'voice' && item.voiceUrl}}" class="checkin-voice">
          <voice-player src="{{item.voiceUrl}}" duration="{{item.voice_duration}}" />
        </view>
        <view wx:elif="{{item.images.length}}" class="imgs">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="index" class="img sm" src="{{img}}" mode="aspectFill" data-index="{{index}}" data-cid="{{item.checkin_id}}" bindtap="previewCheckin" />
        </view>
      </view>
  </block>
  </view>
</scroll-view>

  <!-- 底部操作栏：开始/完成/打卡/编辑/删除/复制 一律贴底，页面中间不放按钮 -->
  <view wx:if="{{task && (canCheckin || canManage || canCopy)}}" class="lp-actions">
    <t-button wx:if="{{canCheckin && task.task_status === 'todo'}}" class="act-start" theme="primary" variant="base" block bindtap="onStart">开始任务</t-button>
    <t-button wx:if="{{canCheckin && task.task_status === 'doing'}}" class="act-finish" theme="default" variant="outline" block bindtap="onFinish">完成任务</t-button>
    <t-button wx:if="{{canCheckin && task.task_status !== 'done'}}" class="act-checkin" theme="primary" variant="base" block bindtap="onCheckin">打卡</t-button>
    <t-button wx:if="{{canCopy}}" class="act-copy" theme="default" variant="outline" block bindtap="onCopy">克隆任务</t-button>
    <t-button wx:if="{{canManage}}" class="act-edit" theme="default" variant="outline" block bindtap="onEdit">编辑</t-button>
    <t-button wx:if="{{canManage}}" class="act-delete" theme="danger" variant="outline" block bindtap="onDelete">删除任务</t-button>
  </view>
</view>
