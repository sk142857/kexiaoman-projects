.page {
  padding: 24rpx 32rpx 48rpx;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  margin-right: 16rpx;
}
.status { font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.task-progress {
  margin-top: 20rpx;
}
.desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3d434c;
  line-height: 1.6;
  white-space: pre-wrap;
}
.tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; }
.created-info {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}
.creator-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: #eef4ff;
}
.creator-avatar--char {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2b6de0;
  font-size: 24rpx;
  font-weight: 600;
}
.created-text {
  font-size: 24rpx;
  color: #8a919f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.foot {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a919f;
  border-top: 1rpx solid #f2f3f5;
  padding-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.foot-deadline {
  color: #e37318;
  flex-shrink: 0;
}
.imgs {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
/* ==================== 打卡记录 ==================== */
.ck-sec {
  margin-top: 44rpx;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title-main {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
}
.section-title-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.section-title-count {
  font-size: 24rpx;
  color: #8a919f;
  background: #eef1f6;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

/* 单条打卡卡片 */
.ck-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.ck-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #6ea8ff, #2b6de0);
}

.ck-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.ck-date {
  display: flex;
  align-items: center;
}
.ck-day {
  font-size: 56rpx;
  font-weight: 800;
  color: #2b6de0;
  line-height: 1;
  margin-right: 16rpx;
}
.ck-date-sub {
  display: flex;
  flex-direction: column;
}
.ck-month {
  font-size: 24rpx;
  color: #5c6470;
  font-weight: 600;
}
.ck-week {
  font-size: 22rpx;
  color: #8a919f;
}

.ck-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.ck-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.ck-score {
  font-size: 24rpx;
  font-weight: 700;
  color: #e37318;
  background: #fdf1e4;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.ck-media {
  margin-top: 24rpx;
}
.ck-media .video {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  background: #1f2329;
}
.ck-media-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a919f;
}
.ck-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ck-img-wrap {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.ck-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ck-img-more {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 35, 41, 0.55);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
}

.ck-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3d434c;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.ck-review {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  background: #fafbfc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.ck-review-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ck-review-body {
  flex: 1;
  min-width: 0;
}
.ck-review-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.ck-review-text {
  font-size: 26rpx;
  color: #3d434c;
  line-height: 1.6;
  word-break: break-all;
}

.ck-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
}
.ck-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.ck-time {
  font-size: 24rpx;
  color: #8a919f;
}
.ck-submitter {
  display: flex;
  align-items: center;
  min-width: 0;
}
.ck-submitter-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef4ff;
  margin-right: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.ck-submitter-avatar--char {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2b6de0;
  font-size: 24rpx;
  font-weight: 600;
}
.ck-submitter .ck-time {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ck-del {
  font-size: 24rpx;
  color: #f6685d;
  padding: 4rpx 8rpx;
}
.ck-source {
  font-size: 22rpx;
  color: #8a919f;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 底部操作栏多按钮：不用 flex gap（Skyline 对自定义组件 host 不生效）、不用相邻兄弟选择器（需 8.0.49+）、不用 t-button 标签选择器（样式隔离），全部用页面内显式类 */
.act-finish,
.act-checkin,
.act-copy,
.act-edit {
  flex: 1;
  margin-right: 16rpx;
}
.act-delete {
  flex: 1;
}
