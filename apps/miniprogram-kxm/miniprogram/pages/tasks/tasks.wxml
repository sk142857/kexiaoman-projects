<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="我的任务"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" lower-threshold="120">
    <view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="index"
      class="tab {{active === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <empty wx:if="{{list.length === 0}}" icon="📝" title="暂无任务" desc="点击右下角 + 新建" />

  <view wx:else class="task-list">
    <view wx:for="{{list}}" wx:key="task_id" class="task" bindtap="goDetail" data-id="{{item.task_id}}">
      <view class="task-bar" style="background: {{item.statusColor}}"></view>
      <view class="task-body">
        <view class="task-head">
          <view class="task-title">{{item.title}}</view>
          <view class="task-status" style="background: {{item.statusBg}}; color: {{item.statusColor}}; border-color: {{item.statusBorder}};">{{item.statusText}}</view>
        </view>
        <view wx:if="{{item.subject || item.sourceText}}" class="task-meta">
          <text wx:if="{{item.subject}}" class="meta-tag">{{item.subject}}</text>
          <text wx:if="{{item.sourceText === 'Web后台'}}" class="meta-tag web">Web后台</text>
          <text wx:if="{{item.secBadge}}" class="meta-tag {{item.secTagTheme === 'danger' ? 'sec-danger' : 'sec-warning'}}">{{item.secBadge}}</text>
          <text wx:if="{{item.deadline}}" class="deadline">截止 {{item.deadline}}</text>
        </view>
        <view class="task-progress">
          <task-progress percent="{{item.progress}}" />
        </view>
        <view class="task-foot">
          <text class="checkins">✅ 打卡 {{item.checkin_count}} 次</text>
          <text wx:if="{{item.score > 0}}" class="score" style="color: {{item.scoreColor}};">评分 {{item.score}}分</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{list.length > 0 && !hasMore}}" class="list-foot">— 没有更多了 —</view>
  <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>

  <view class="fab" bindtap="goCreate">＋</view>
  </view>
</scroll-view>
</view>
