.page {
  /* tabBar 页面统一：safe-bottom(180rpx) + 128rpx（底部有 FAB，需更大留白） */
  padding: 24rpx 32rpx calc(var(--safe-bottom) + 128rpx);
}
.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5c6470;
}
.tab.active {
  background: #2b6de0;
  color: #ffffff;
  font-weight: 600;
}
.task {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.task-bar {
  width: 8rpx;
  flex-shrink: 0;
}
.task-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}
.task-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.task-title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  word-break: break-all;
}
.task-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}
.task-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.meta-tag {
  font-size: 22rpx;
  color: #2b6de0;
  background: #eef4ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.meta-tag.outline {
  color: #5c6470;
  background: #f5f7fa;
}
.meta-tag.voice {
  color: #d46b08;
  background: #fff7e6;
}
.meta-tag.video {
  color: #08979c;
  background: #e6fffb;
}
.meta-tag.web {
  color: #722ed1;
  background: #f9f0ff;
}
.meta-tag.sec-warning {
  color: #d46b08;
  background: #fff7e6;
}
.meta-tag.sec-danger {
  color: #f6685d;
  background: #fdeeed;
}
.deadline {
  font-size: 24rpx;
  color: #8a919f;
}
.task-progress {
  margin-top: 18rpx;
}
.task-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8a919f;
}
.score {
  font-weight: 600;
}
.list-foot {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(var(--safe-bottom) + 32rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2b6de0;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 224, 0.4);
}
