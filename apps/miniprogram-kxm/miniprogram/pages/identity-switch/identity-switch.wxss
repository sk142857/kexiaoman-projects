.page {
  padding: 24rpx 32rpx calc(var(--safe-bottom) + 240rpx);
}

/* ==================== 提示文案 ==================== */
.tip-card {
  background: #eef4ff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.tip-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5c6470;
  line-height: 1.7;
}
.tip-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #874d00;
  line-height: 1.6;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.tip-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2b6de0;
  font-weight: 600;
}

/* ==================== 切换子菜单 ==================== */
.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
}
.menu-item:active {
  background: rgba(31, 35, 41, 0.03);
}
.menu-item + .menu-item {
  border-top: 1rpx solid #f0f1f3;
}
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-icon--blue { background: #e6f4ff; }
.menu-icon--green { background: #e6faf4; }
.menu-icon--purple { background: #f9f0ff; }
.menu-label-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.menu-label {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-desc {
  font-size: 22rpx;
  color: #8a919f;
}
.identity-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.role-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}
.role-tag--parent {
  color: #2b6de0;
  background: #e6f4ff;
}
.role-tag--admin {
  color: #fa541c;
  background: #fff2e8;
}
.role-tag--family {
  color: #722ed1;
  background: #f9f0ff;
}
.role-tag--student {
  color: #52c41a;
  background: #e6faf4;
}
.pin-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #8c6d1f;
  background: #fffbe6;
}
.identity-tag {
  font-size: 22rpx;
  color: #2b6de0;
  background: #e6f4ff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.menu-icon--amber { background: #fff7e6; }
.identity-status {
  font-size: 24rpx;
  color: #8a919f;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.identity-status--on {
  color: #2b6de0;
}
.menu-arrow {
  font-size: 32rpx;
  color: #b0b6c0;
}

.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}

/* ==================== 底部固定操作栏 ==================== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.footer t-button {
  flex: 1;
}
.footer-row {
  display: flex;
  width: 100%;
  gap: 24rpx;
}
.footer-prev {
  flex-shrink: 0;
}
.footer-prev t-button {
  width: 200rpx;
}
.footer-main {
  flex: 1;
  min-width: 0;
}
.footer-main t-button {
  width: 100%;
}
