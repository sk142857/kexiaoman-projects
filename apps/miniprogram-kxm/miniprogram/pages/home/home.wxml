<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="课小满"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="page">
  <!-- 管理员/家长/家属：当前查看的孩子（点击前往孩子档案页切换默认孩子） -->
  <view wx:if="{{isManager}}" class="current-bar" bindtap="goChildren">
    <view class="current-picker">
      <text class="current-label">👶 当前孩子</text>
      <text class="current-name">{{viewStudentName || '未设置'}}</text>
      <text class="current-arrow">›</text>
    </view>
  </view>

  <!-- 家长/管理员尚未创建孩子档案：首页顶部引导创建 -->
  <view wx:if="{{needChildPrompt}}" class="child-guide" bindtap="goAddChild">
    <view class="child-guide-icon">👶</view>
    <view class="child-guide-main">
      <view class="child-guide-title">添加孩子档案</view>
      <view class="child-guide-desc">创建孩子档案后，即可查看学习情况并生成孩子邀请码</view>
    </view>
    <view class="child-guide-btn">去创建</view>
  </view>

  <block>
    <!-- 等级卡片 -->
    <view class="level-card">
      <view class="level-top">
        <view>
          <view class="greet">Hi，{{staff.nickname || '同学'}}</view>
          <view class="level-title">Lv.{{level.level}} · {{level.title}}</view>
        </view>
        <view class="level-num">{{level.level}}</view>
      </view>
      <view class="progress-wrap">
        <t-progress
          theme="plump"
          percentage="{{level.progress}}"
          stroke-width="10"
          color="#ffffff"
          track-color="rgba(255,255,255,0.3)"
          label="{{false}}"
        />
      </view>
      <view class="xp-row">
        <text>经验值 {{level.xp}}</text>
        <text wx:if="{{level && !level.maxLevel}}">距 Lv.{{level.level + 1}} 还差 {{level.xpToNext}}</text>
        <text wx:elif="{{level && level.maxLevel}}">已满级</text>
      </view>
      <view class="level-foot">
        <button class="level-share" open-type="share" hover-class="level-share--hover" aria-label="分享课小满">
          <t-icon name="share" size="30rpx" />
          <text>把课小满分享给家人</text>
        </button>
      </view>
    </view>

    <!-- 提醒 -->
    <view class="section">
      <view class="section-title">今日提醒</view>
      <view wx:if="{{notifyUnread > 0}}" class="reminder r-notify" hover-class="reminder--active" bindtap="goNotifications">
        <view class="reminder-title">有 {{notifyUnread}} 条新通知</view>
        <view class="reminder-desc">审核结果、内容动态等，点击查看 ›</view>
      </view>
      <view wx:for="{{reminders}}" wx:key="index" class="reminder r-{{item.severity}}">
        <view class="reminder-title">{{item.title}}</view>
        <view class="reminder-desc">{{item.desc}}</view>
      </view>
    </view>

    <!-- 统计 -->
    <view class="stat-grid">
      <view class="stat-card stat-total"><view class="num">{{stats.totalTasks}}</view><view class="label">任务</view></view>
      <view class="stat-card stat-todo"><view class="num">{{stats.todoCount}}</view><view class="label">待完成</view></view>
      <view class="stat-card stat-doing"><view class="num">{{stats.doingCount}}</view><view class="label">进行中</view></view>
      <view class="stat-card stat-done"><view class="num">{{stats.doneCount}}</view><view class="label">已完成</view></view>
    </view>

    <!-- 完成率 -->
    <view class="section">
      <view class="section-title">任务完成率</view>
      <view class="completion-card">
        <t-progress
          theme="plump"
          percentage="{{stats.completionRate}}"
          stroke-width="24"
          label="{{true}}"
          color="{{ {  from: '#0052D9', to: '#00A870' } }}"
          status="active"
        />
        <view class="completion-sub">已完成 {{stats.doneCount}} / {{stats.totalTasks}} 个任务</view>
      </view>
    </view>

    <!-- 近7天 -->
    <view class="section">
      <view class="section-title">近 7 天打卡</view>
      <view class="days-card">
        <view class="days-head">
          <text class="days-title">连续打卡</text>
          <text class="days-streak">🔥 {{streak.current}} 天</text>
        </view>
        <view class="days-body">
          <view wx:for="{{days}}" wx:key="index" class="day">
            <view class="day-bar {{item.active ? 'on' : ''}}" style="height: {{item.h}}rpx"></view>
            <view class="day-date {{item.active ? 'on' : ''}}">{{item.date}}</view>
          </view>
        </view>
        <view class="days-foot">本周共打卡 {{weekCheckinCount}} 次</view>
      </view>
    </view>

    <!-- 最近打卡 -->
    <view class="section">
      <view class="section-title">最近打卡</view>
      <empty wx:if="{{recentCheckins.length === 0}}" icon="📊" title="还没有打卡记录" desc="完成任务后提交打卡即可展示" />
      <view wx:for="{{recentCheckins}}" wx:key="checkin_id" class="recent" bindtap="goTaskDetail" data-id="{{item.task_id}}">
        <view class="recent-bar recent-bar--{{item.checkin_type}}"></view>
        <view class="recent-main">
          <view class="recent-head">
            <view class="recent-title">{{item.task_title}}</view>
            <view class="recent-arrow">›</view>
          </view>
          <view class="recent-meta">
            <text class="recent-date">{{item.checkin_date}}</text>
            <t-tag class="tag-gap" size="small" shape="round" style="{{item.checkinTypeStyle}}">{{item.checkinTypeText}}</t-tag>
            <text wx:if="{{item.secBadge}}" class="recent-sec {{item.secTagTheme === 'danger' ? 'sec-danger' : 'sec-warning'}}">{{item.secBadge}}</text>
          </view>
          <view class="recent-note">{{item.note || '（无备注）'}}</view>
        </view>
      </view>
    </view>
  </block>
  </view>
</scroll-view>
</view>
