.page {
  /* tabBar 页面统一：safe-bottom(180rpx) + 64rpx 额外留白 */
  padding: 24rpx 32rpx calc(var(--safe-bottom) + 64rpx);
}

.current-bar {
  margin-bottom: 24rpx;
}
.current-picker {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #eaf2ff, #eef4ff);
  border: 2rpx solid #d6e4ff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}
.current-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  line-height: 44rpx;
  color: #2b6de0;
  font-weight: 600;
}
.current-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.current-arrow {
  color: #8a919f;
  font-size: 36rpx;
  line-height: 44rpx;
}

.level-card {
  background: linear-gradient(135deg, #2b6de0, #5a8cff);
  border-radius: 24rpx;
  padding: 36rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 224, 0.3);
}
.level-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.greet {
  font-size: 28rpx;
  opacity: 0.9;
}
.level-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 8rpx;
}
.level-num {
  font-size: 96rpx;
  font-weight: 800;
  opacity: 0.85;
}
.progress-wrap {
  margin-top: 24rpx;
}
.completion-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.completion-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a919f;
}
.xp-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  opacity: 0.9;
}
.streak-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}
.streak-item {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
}

.section {
  margin-top: 40rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.reminder {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.r-danger { background: #fff1f0; }
.r-warning { background: #fff7e6; }
.r-info { background: #e6f4ff; }
.r-success { background: #f6ffed; }
.r-notify {
  background: #ffece8;
}
.r-notify .reminder-title { color: #d93026; }
.r-notify .reminder-desc { color: #e85c54; }
.reminder--active { opacity: 0.85; }
.reminder-title { font-size: 30rpx; font-weight: 600; color: #1f2329; }
.reminder-desc { margin-top: 8rpx; font-size: 26rpx; color: #5c6470; }

.stat-grid {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}
.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  border-left: 8rpx solid transparent;
}
.stat-total { border-left-color: #2b6de0; }
.stat-todo { border-left-color: #f6685d; }
.stat-doing { border-left-color: #e37318; }
.stat-done { border-left-color: #16c79a; }
.num { font-size: 40rpx; font-weight: 700; color: #1f2329; }
.stat-total .num { color: #2b6de0; }
.stat-todo .num { color: #f6685d; }
.stat-doing .num { color: #e37318; }
.stat-done .num { color: #16c79a; }
.label { margin-top: 6rpx; font-size: 24rpx; color: #8a919f; }

.days-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
}
.days-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.days-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.days-streak {
  font-size: 26rpx;
  font-weight: 600;
  color: #fa8c16;
}
.days-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 190rpx;
}
.day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 68rpx;
}
.day-bar {
  width: 34rpx;
  min-height: 10rpx;
  background: #eef0f3;
  border-radius: 8rpx;
}
.day-bar.on {
  background: linear-gradient(180deg, #5a8cff, #2b6de0);
}
.day-date {
  font-size: 20rpx;
  color: #b0b6c0;
}
.day-date.on {
  color: #2b6de0;
  font-weight: 600;
}
.days-foot {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 24rpx;
  color: #8a919f;
  text-align: center;
}

/* ==================== 最近打卡：左侧色带 + 标题/日期/类型标签/备注 结构 ==================== */
.recent {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.recent:active {
  background: #f7f9fc;
}
.recent-bar {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: #2b6de0;
}
.recent-bar--image { background: #2b6de0; }
.recent-bar--voice { background: #fa8c16; }
.recent-bar--video { background: #13c2c2; }
.recent-main {
  flex: 1;
  min-width: 0;
}
.recent-head {
  display: flex;
  align-items: center;
  min-width: 0;
}
.recent-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #c0c6cf;
  font-size: 32rpx;
  font-weight: 700;
}
.recent-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.recent-date {
  font-size: 22rpx;
  color: #2b6de0;
  background: #eef4ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.recent-type {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.recent-type--image { color: #2b6de0; background: #eef4ff; }
.recent-type--voice { color: #d46b08; background: #fff7e6; }
.recent-type--video { color: #08979c; background: #e6fffb; }
.recent-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a919f;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-sec {
  margin-top: 0;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  width: fit-content;
}
.recent-sec.sec-warning { color: #d46b08; background: #fff7e6; }
.recent-sec.sec-danger { color: #f6685d; background: #fdeeed; }
