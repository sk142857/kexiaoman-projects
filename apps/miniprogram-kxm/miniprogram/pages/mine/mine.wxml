<view class="mine-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="我的"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="mine-scroll">
    <view class="mine-main">

      <!-- 用户卡 -->
      <view class="profile-card" bindtap="goProfileEdit" hover-class="profile-card--active">
        <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-avatar profile-avatar--char">{{avatarChar}}</view>
        <view class="profile-info">
          <view class="profile-name-row">
            <text class="profile-name">{{nickname}}</text>
            <text class="profile-edit">✏️</text>
          </view>
          <text class="profile-meta">ID {{userId || '--'}} · {{roleText}}</text>
        </view>
        <text class="profile-arrow">›</text>
      </view>

      <!-- 数据统计四宫格 -->
      <view class="stats-card">
        <view class="stat-item">
          <text class="stat-num">{{stats.totalTasks}}</text>
          <text class="stat-label">任务</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{stats.totalCheckins}}</text>
          <text class="stat-label">打卡</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{streak.current}}</text>
          <text class="stat-label">连击</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{level.level || 0}}</text>
          <text class="stat-label">等级</text>
        </view>
      </view>

      <!-- 功能菜单列表（身份切换与普通菜单放同一列表） -->
      <view class="menu-card">
        <!-- 身份切换：多身份共用微信时显示，子菜单与提示文案在身份切换页 -->
        <view wx:if="{{identities.length > 1}}" class="menu-item" bindtap="goIdentitySwitch">
          <view class="menu-icon menu-icon--blue">🔄</view>
          <view class="menu-label-col">
            <text class="menu-label">身份切换</text>
            <text class="menu-desc">当前：{{roleText}} · 共 {{identities.length}} 个身份</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <!-- 孩子档案：家长/家属可查看，家长可维护 -->
        <view wx:if="{{isManager}}" class="menu-item" bindtap="goChildren">
          <view class="menu-icon menu-icon--green">👶</view>
          <text class="menu-label">孩子档案</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goNotifications">
          <view class="menu-icon menu-icon--rose">📣</view>
          <text class="menu-label">系统通知</text>
          <text wx:if="{{notifyUnread > 0}}" class="notify-badge">{{notifyUnread > 99 ? '99+' : notifyUnread}}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goBadges">
          <view class="menu-icon menu-icon--amber">🏅</view>
          <text class="menu-label">我的奖章</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goSettings">
          <view class="menu-icon menu-icon--gray">⚙️</view>
          <text class="menu-label">个人设置</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="foot">课小满 · 邀请码准入制</view>
    </view>
  </scroll-view>
</view>
