<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="我的待办"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y scroll-top="{{scrollTop}}" class="lp-scroll" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" lower-threshold="120">
    <view class="todo-main">

      <!-- 顶部提示 + 今日概览统计 -->
      <view class="todo-tip">
        <view class="todo-tip-head">
          <text class="todo-tip-title">{{isManager ? '待审核打卡' : '我的待办'}}</text>
          <text class="todo-tip-sub">{{isManager ? '孩子提交打卡后进入这里，审核通过即完成任务' : '只展示当前需要你处理的任务'}}</text>
        </view>
        <view class="todo-stats">
          <block wx:if="{{isManager}}">
            <view class="todo-stat">
              <text class="todo-stat-num">{{todayStats.todayReviewed}}</text>
              <text class="todo-stat-label">今日已审核</text>
            </view>
            <view class="todo-stat">
              <text class="todo-stat-num">{{total}}</text>
              <text class="todo-stat-label">待审核</text>
            </view>
          </block>
          <block wx:else>
            <view class="todo-stat">
              <text class="todo-stat-num">{{todayStats.todayCheckins}}</text>
              <text class="todo-stat-label">今日打卡</text>
            </view>
            <view class="todo-stat">
              <text class="todo-stat-num">{{todayStats.todayTasksDone}}</text>
              <text class="todo-stat-label">今日完成</text>
            </view>
          </block>
        </view>
      </view>

      <empty wx:if="{{!loading && list.length === 0}}" icon="{{isManager ? '📋' : '🎉'}}" title="{{isManager ? '暂无待审核打卡' : '太棒了，没有待办任务'}}" desc="{{isManager ? '孩子的打卡会展示在这里' : '所有任务都完成啦'}}" />

      <!-- 学生待办：未完成任务（待完成 + 进行中） -->
      <block wx:if="{{!isManager}}">
        <view wx:for="{{list}}" wx:key="task_id" class="todo-item" bindtap="goTask" data-id="{{item.task_id}}">
          <view class="todo-bar"></view>
          <view class="todo-body">
            <view class="todo-title">{{item.title}}</view>
            <view class="todo-meta">
              <text wx:if="{{item.task_status === 'doing'}}" class="todo-tag doing">进行中</text>
              <text wx:elif="{{item.task_status === 'todo'}}" class="todo-tag todo">待完成</text>
              <text wx:if="{{item.subject}}" class="todo-tag">{{item.subject}}</text>
              <text wx:if="{{item.sourceText === 'Web后台'}}" class="todo-tag web">Web后台发布</text>
              <text wx:if="{{item.checkin_type === 'voice'}}" class="todo-tag voice">语音打卡</text>
              <text wx:if="{{item.deadline}}" class="todo-deadline">截止 {{item.deadline}}</text>
            </view>
            <view class="todo-foot">
              <text class="todo-go">去处理 ›</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 家长/家属/管理员待办：待审核打卡 -->
      <block wx:else>
        <view wx:for="{{list}}" wx:key="checkin_id" class="review-item">
          <view class="review-head">
            <view class="review-avatar">{{item.studentAvatar}}</view>
            <view class="review-student">
              <text class="review-name">{{item.student.nickname}}</text>
              <text class="review-time">{{item.submitTime || item.checkin_date}} 提交</text>
            </view>
            <text wx:if="{{item.sourceText === 'Web后台'}}" class="review-badge source">Web后台</text>
            <text wx:if="{{item.secBadge}}" class="review-badge {{item.secTagTheme === 'danger' ? 'sec-danger' : 'sec-warning'}}">{{item.secBadge}}</text>
            <text class="review-badge">待审核</text>
          </view>
          <view class="review-task" bindtap="goTask" data-id="{{item.task_id}}">
            <text class="review-task-title">{{item.task_title}}</text>
            <text class="review-task-arrow">›</text>
          </view>
          <view wx:if="{{item.checkin_note}}" class="review-note">{{item.checkin_note}}</view>
          <view wx:if="{{item.checkin_type === 'video' && item.videoUrl}}" class="review-video">
            <video class="video" src="{{item.videoUrl}}" controls objectFit="contain" poster="{{item.videoCover}}" />
            <view wx:if="{{item.video_duration}}" class="checkin-video-meta">时长 {{item.video_duration}} 秒</view>
          </view>
          <view wx:elif="{{item.checkin_type === 'voice' && item.voiceUrl}}" class="review-voice">
            <voice-player src="{{item.voiceUrl}}" duration="{{item.voice_duration}}" />
          </view>
          <view wx:elif="{{item.images.length}}" class="review-imgs">
            <view
              wx:for="{{item.images}}"
              wx:key="index"
              wx:for-item="img"
              wx:for-index="idx"
              class="review-img-wrap"
            >
              <image
                class="review-img {{item.imageStates[idx] === 'reviewing' ? 'review-img--locked' : ''}}"
                src="{{img}}"
                mode="aspectFill"
                lazy-load
                data-url="{{item.previewImages[idx] || img}}"
                data-cid="{{item.checkin_id}}"
                data-index="{{idx}}"
                bindtap="preview"
              />
              <view wx:if="{{item.imageStates[idx] === 'reviewing'}}" class="review-img-lock">
                <view class="review-img-lock-icon">🔒</view>
                <view class="review-img-lock-text">安全审核中</view>
              </view>
            </view>
          </view>
          <view class="review-actions">
            <t-button class="review-btn" theme="danger" variant="outline" size="small" bindtap="onReject" data-id="{{item.checkin_id}}" disabled="{{submitting}}">审核不通过</t-button>
            <t-button class="review-btn" theme="primary" variant="base" size="small" bindtap="onApprove" data-id="{{item.checkin_id}}" disabled="{{submitting}}">审核通过</t-button>
          </view>
        </view>
      </block>

      <view wx:if="{{!loading && list.length > 0}}" class="todo-foot-note">处理完成后将自动从待办移除</view>

      <view wx:if="{{list.length > 0 && !hasMore}}" class="todo-foot-note">— 没有更多了 —</view>
      <view wx:if="{{loadingMore}}" class="todo-foot-note">加载中…</view>
    </view>
  </scroll-view>

  <!-- 审核不通过弹层 -->
  <view wx:if="{{rejectVisible}}" class="mask" catchtouchmove="true">
    <view class="sheet">
      <view class="sheet-title">审核不通过</view>
      <view class="sheet-task" wx:if="{{rejectItem}}">{{rejectItem.student.nickname}} · {{rejectItem.task_title}}</view>
      <view class="field">
        <view class="label">评分（0-10）</view>
        <input class="input" type="number" value="{{rejectScore}}" bindinput="onRejectScore" placeholder="0" />
      </view>
      <view class="field">
        <view class="label">审核说明 / 原因</view>
        <textarea class="textarea" value="{{rejectNote}}" bindinput="onRejectNote" placeholder="请填写不通过原因（选填）" maxlength="500" />
      </view>
      <view class="sheet-actions">
        <t-button theme="default" variant="outline" block bindtap="cancelReject">取消</t-button>
        <t-button theme="danger" variant="base" block bindtap="submitReject" loading="{{submitting}}">确认驳回</t-button>
      </view>
    </view>
  </view>
</view>
