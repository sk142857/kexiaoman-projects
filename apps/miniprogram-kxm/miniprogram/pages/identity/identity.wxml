<view class="lp-page">
  <!-- 头部：品牌 + 步骤条 -->
  <view wx:if="{{!locked}}" class="header">
    <hero sub="{{rebind ? '重新选择身份与账号，更换当前绑定' : '选择身份并绑定，即可开始使用'}}" />
    <t-steps class="steps" current="{{step}}" readonly>
      <t-step-item title="选择身份" />
      <t-step-item title="绑定账号" />
      <t-step-item title="完成" />
    </t-steps>
  </view>

  <!-- 锁定提示 -->
  <scroll-view wx:if="{{locked}}" scroll-y class="lp-scroll">
    <view class="locked">
      <view class="locked-icon">
        <t-icon name="lock-on" size="72rpx" />
      </view>
      <view class="locked-title">访问已锁定</view>
      <view class="locked-desc">{{lockedMsg}}</view>
      <view wx:if="{{lockInfo}}" class="locked-info">
        <view class="info-row">
          <view class="info-label">锁定原因</view>
          <view class="info-value">{{lockInfo.reason || '—'}}</view>
        </view>
        <view wx:if="{{lockInfo.lockedAt}}" class="info-row">
          <view class="info-label">锁定时间</view>
          <view class="info-value">{{lockInfo.lockedAt}}</view>
        </view>
        <view wx:if="{{lockInfo.unlockAt}}" class="info-row">
          <view class="info-label">解封时间</view>
          <view class="info-value">{{lockInfo.unlockAt}}</view>
        </view>
      </view>
      <button class="locked-contact" open-type="contact">联系管理员</button>
    </view>
  </scroll-view>

  <!-- 步骤一：选择身份 -->
  <scroll-view wx:elif="{{step === 0}}" scroll-y class="lp-scroll content">
    <view class="cards">
      <view class="card {{identity === 'parent' ? 'card--active' : ''}}" bindtap="onPickIdentity" data-identity="parent">
        <view class="card-icon icon--parent"><t-icon name="home-filled" size="44rpx" /></view>
        <view class="card-main">
          <view class="card-name">{{copy.parent.name}}</view>
          <view class="card-desc">{{copy.parent.desc}}</view>
        </view>
        <view class="card-check {{identity === 'parent' ? 'card-check--active' : ''}}"><t-icon name="check-circle-filled" size="40rpx" /></view>
      </view>

      <view class="card {{identity === 'personal' ? 'card--active' : ''}}" bindtap="onPickIdentity" data-identity="personal">
        <view class="card-icon icon--personal"><t-icon name="user-filled" size="44rpx" /></view>
        <view class="card-main">
          <view class="card-name">{{copy.personal.name}}</view>
          <view class="card-desc">{{copy.personal.desc}}</view>
        </view>
        <view class="card-check {{identity === 'personal' ? 'card-check--active' : ''}}"><t-icon name="check-circle-filled" size="40rpx" /></view>
      </view>

      <!-- 我有邀请码：孩子/家属统一输入邀请码，由后端按邀请码 kind 识别（学生码/家长码/家属共享码） -->
      <view class="card {{identity === 'invite' ? 'card--active' : ''}}" bindtap="onPickIdentity" data-identity="invite">
        <view class="card-icon icon--invite"><t-icon name="ticket" size="44rpx" /></view>
        <view class="card-main">
          <view class="card-name">{{copy.invite.name}}</view>
          <view class="card-desc">{{copy.invite.desc}}</view>
        </view>
        <view class="card-check {{identity === 'invite' ? 'card-check--active' : ''}}"><t-icon name="check-circle-filled" size="40rpx" /></view>
      </view>
    </view>
  </scroll-view>

  <!-- 步骤二：绑定信息 -->
  <scroll-view wx:elif="{{step === 1}}" scroll-y class="lp-scroll content">
    <view wx:if="{{rebind}}" class="rebind-tip">当前绑定已解除，重新选择身份后绑定新账号</view>

    <view wx:if="{{identity === 'parent'}}" class="parent-box">
      <view class="parent-title">创建主家长账号</view>
      <view class="parent-items">
        <view class="parent-item">自动创建家庭档案与后台登录账号</view>
        <view class="parent-item">生成家属共享码，可邀请家属加入</view>
        <view class="parent-item">孩子档案可在「我的」中维护</view>
      </view>
    </view>

    <view wx:if="{{identity === 'personal'}}" class="parent-box">
      <view class="parent-title">创建个人账号</view>
      <view class="parent-items">
        <view class="parent-item">自动创建个人账号，无需邀请码</view>
        <view class="parent-item">自己发布任务、自己打卡</view>
        <view class="parent-item">不支持身份切换，最简单</view>
      </view>
    </view>

    <view wx:if="{{identity === 'invite'}}" class="code-box">
      <view class="code-label">邀请码</view>
      <input
        class="input"
        type="text"
        maxlength="6"
        placeholder="{{placeholder}}"
        placeholder-class="ph"
        value="{{code}}"
        focus="{{focusInput}}"
        bindinput="onInput"
      />
      <view class="code-hint">6 位大写字母或数字，由家长或管理员提供</view>
      <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
    </view>
  </scroll-view>

  <!-- 步骤三：完成 -->
  <scroll-view wx:elif="{{step === 2}}" scroll-y class="lp-scroll content">
    <view class="done">
      <view class="done-icon"><t-icon name="check-circle-filled" size="120rpx" /></view>
      <view class="done-title">{{(identity === 'parent' || identity === 'personal') ? '创建成功' : '绑定成功'}}</view>
      <view class="done-desc">{{identity === 'parent' ? '账号创建成功\n进入首页添加孩子档案' : identity === 'personal' ? '个人账号创建成功\n开始创建任务并打卡' : '已加入课小满\n开始学习'}}</view>

      <!-- 共用微信风险提示：多身份 + 家长未设 PIN -->
      <view wx:if="{{riskPrompt}}" class="pin-warn">
        <view class="pin-warn--title">⚠️ 建议开启身份 PIN 锁</view>
        <view class="pin-warn--desc">检测到您与孩子共用此微信。未开启 PIN 锁时，孩子可自行切换到「家长」身份，查看家庭信息、后台账号、家属共享等敏感内容。建议开启 PIN 锁保护（仅家长知道密码）。</view>
      </view>
    </view>
  </scroll-view>

  <!-- 固定底部操作栏 -->
  <view wx:if="{{!locked}}" class="footer">
    <block wx:if="{{step === 0}}">
      <view class="footer-row">
        <view wx:if="{{rebind}}" class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="goHome">首页</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onNext" disabled="{{!identity}}">下一步</t-button>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 1}}">
      <view class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="onPrev">上一步</t-button>
        </view>
        <view class="footer-main">
          <t-button
            class="btn"
            theme="primary"
            block
            bindtap="onPrimary"
            loading="{{loading || submitting}}"
            disabled="{{(identity === 'parent' || identity === 'personal') ? submitting : (code.length !== 6 || loading)}}"
          >{{(identity === 'parent' || identity === 'personal') ? '确认创建' : '绑定'}}</t-button>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 2}}">
      <view wx:if="{{riskPrompt}}" class="footer-row">
        <view class="footer-prev">
          <t-button class="btn" variant="outline" block bindtap="goPin">开启 PIN 锁</t-button>
        </view>
        <view class="footer-main">
          <t-button class="btn" theme="primary" block bindtap="onFinish">进入首页</t-button>
        </view>
      </view>
      <t-button wx:else class="btn" theme="primary" block bindtap="onFinish">进入首页</t-button>
    </block>
  </view>
</view>
