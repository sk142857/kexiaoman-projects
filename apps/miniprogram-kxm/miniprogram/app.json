{
  "pages": [
    "pages/login/login",
    "pages/home/home",
    "pages/todo/todo",
    "pages/tasks/tasks",
    "pages/mine/mine",
    "pages/identity/identity",
    "pages/identity-switch/identity-switch",
    "pages/service-error/service-error"
  ],
  "subpackages": [
    {
      "root": "pkg-task",
      "name": "pkg-task",
      "pages": [
        "task-detail/task-detail",
        "task-edit/task-edit",
        "checkin/checkin"
      ]
    },
    {
      "root": "pkg-family",
      "name": "pkg-family",
      "pages": [
        "children/children",
        "child-edit/child-edit",
        "shares/shares"
      ]
    },
    {
      "root": "pkg-mine",
      "name": "pkg-mine",
      "pages": [
        "settings/settings",
        "backend-account/backend-account",
        "subscribe/subscribe",
        "notifications/notifications",
        "badges/badges",
        "collections/collections",
        "profile-edit/profile-edit"
      ]
    }
  ],
  "preloadRule": {
    "pages/login/login": { "network": "all", "packages": ["pkg-task"] },
    "pages/home/home": { "network": "all", "packages": ["pkg-task"] },
    "pages/tasks/tasks": { "network": "all", "packages": ["pkg-task"] },
    "pages/todo/todo": { "network": "all", "packages": ["pkg-task"] },
    "pages/mine/mine": { "network": "all", "packages": ["pkg-mine", "pkg-family"] }
  },
  "window": {
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "light",
    "navigationStyle": "custom"
  },
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "disableABTest": true
    }
  },
  "tabBar": {
    "custom": true,
    "color": "#8a919f",
    "selectedColor": "#2B6DE0",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页" },
      { "pagePath": "pages/todo/todo", "text": "待办" },
      { "pagePath": "pages/tasks/tasks", "text": "任务" },
      { "pagePath": "pages/mine/mine", "text": "我的" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "usingComponents": {
    "empty": "/components/empty/empty",
    "voice-player": "/components/voice-player/voice-player",
    "task-progress": "/components/task-progress/task-progress"
  },
  "lazyCodeLoading": "requiredComponents"
}
