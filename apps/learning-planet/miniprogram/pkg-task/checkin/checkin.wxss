.header {
  flex-shrink: 0;
  background: linear-gradient(180deg, #eaf2ff 0%, #eef4ff 100%);
  --td-navbar-background: transparent;
}
.steps-band {
  padding: 48rpx 48rpx 40rpx;
}
.task-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.steps {
  width: 100%;
}

.content {
  padding: 24rpx 32rpx 240rpx;
  box-sizing: border-box;
}
.form {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
  padding: 8rpx 0;
}
.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 统一有边框输入框 */
.picker-box {
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 500;
}
.picker-box text:first-child {
  flex: 1;
}
.arrow {
  margin-left: 16rpx;
  color: #c9cdd4;
  font-size: 36rpx;
  line-height: 1;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8dce3;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1f2329;
  padding: 20rpx 24rpx;
}
.ph {
  color: #b0b6c0;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.img.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #b0b6c0;
  border: 2rpx dashed #d8dce3;
  background: #fafbfc;
}

/* ==================== 固定底部操作栏 ==================== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.footer t-button {
  flex: 1;
}
.footer-row {
  display: flex;
  width: 100%;
  gap: 24rpx;
}
.footer-prev {
  flex-shrink: 0;
}
.footer-prev t-button {
  width: 200rpx;
}
.footer-main {
  flex: 1;
  min-width: 0;
}
.footer-main t-button {
  width: 100%;
}
