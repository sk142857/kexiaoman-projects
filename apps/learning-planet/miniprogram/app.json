{
  "pages": [
    "pages/home/home",
    "pages/todo/todo",
    "pages/tasks/tasks",
    "pages/mine/mine",
    "pages/identity/identity",
    "pages/children/children",
    "pages/child-edit/child-edit",
    "pages/shares/shares",
    "pages/backend-account/backend-account",
    "pages/task-detail/task-detail",
    "pages/task-edit/task-edit",
    "pages/checkin/checkin",
    "pages/collections/collections",
    "pages/badges/badges",
    "pages/subscribe/subscribe"
  ],
  "window": {
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "light",
    "navigationStyle": "custom"
  },
  "renderer": "skyline",
  "componentFramework": "glass-easel",
