    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页" },
      { "pagePath": "pages/todo/todo", "text": "待办" },
      { "pagePath": "pages/tasks/tasks", "text": "任务" },
      { "pagePath": "pages/mine/mine", "text": "我的" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
