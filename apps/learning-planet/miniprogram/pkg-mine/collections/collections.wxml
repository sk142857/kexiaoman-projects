<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="合集管理"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y class="lp-scroll">
    <view class="page">
  <view wx:if="{{list.length === 0}}" class="empty-card">
    <t-empty description="还没有合集，点击下方 + 新建" />
  </view>

  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="collection_id" class="item">
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
        <view class="count">📦 {{item.task_count}} 个任务</view>
      </view>
      <view class="del" wx:if="{{isAdmin}}" data-id="{{item.collection_id}}" bindtap="onDelete">删除      </view>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="fab" bindtap="openCreate">＋</view>
  </view>
</scroll-view>

  <!-- 新建合集（仅管理员） -->
  <view wx:if="{{showCreate && isAdmin}}" class="mask">
    <view class="modal">
      <view class="modal-title">新建合集</view>
      <input class="modal-input" placeholder="合集名称" value="{{name}}" bindinput="onName" />
      <input class="modal-input" placeholder="合集描述（可选）" value="{{description}}" bindinput="onDesc" />
      <view class="modal-ops">
        <t-button class="modal-btn modal-btn--cancel" theme="default" variant="outline" block bindtap="closeCreate">取消</t-button>
        <t-button class="modal-btn modal-btn--submit" theme="primary" variant="base" block bindtap="submitCreate" loading="{{submitting}}">创建</t-button>
      </view>
    </view>
  </view>
</view>
