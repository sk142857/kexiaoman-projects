.page {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}
.welcome {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.tip-card {
  background: #fff7e6;
  color: #8a919f;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.phone-tip {
  background: #e6f4ff;
  color: #2b6de0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.account-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.field {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 26rpx;
  color: #8a919f;
}
.value-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.value {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  letter-spacing: 1rpx;
}
.value.masked {
  letter-spacing: 4rpx;
  color: #2b6de0;
}
.mini-btn {
  font-size: 24rpx;
  color: #2b6de0;
  background: #e6f4ff;
  border-radius: 10rpx;
  padding: 10rpx 22rpx;
  flex-shrink: 0;
}
.field-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b0b6c0;
}
.reset-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #ff8c1a;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reset-btn.disabled {
  opacity: 0.6;
}
.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
}
