.page {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}
.intro-card {
  background: linear-gradient(135deg, #fff7e6 0%, #ffffff 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.intro-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a919f;
  line-height: 1.6;
}
.gen-btn {
  height: 96rpx;
  border-radius: 20rpx;
  background: #2b6de0;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
}
.share-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.share-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.share-code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #2b6de0;
}
.share-code.off {
  color: #c0c6cf;
  text-decoration: line-through;
}
.share-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}
.s-available { color: #52c41a; background: #f6ffed; }
.s-bound { color: #2b6de0; background: #e6f4ff; }
.s-revoked { color: #8a919f; background: #f0f2f5; }
.share-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a919f;
}
.share-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
.share-btn {
  font-size: 26rpx;
  color: #2b6de0;
  background: #e6f4ff;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
}
.share-btn.danger {
  color: #ff4d4f;
  background: #fff1f0;
}
.foot {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
  line-height: 1.6;
}
