.page {
  padding: 24rpx 32rpx 48rpx;
}
.form {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}
.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.field-row {
  display: flex;
  padding: 0;
}
.field.half {
  flex: 1;
  min-width: 0;
  padding: 28rpx 32rpx;
}
.field.half + .field.half {
  border-left: 1rpx solid #f2f3f5;
}
.label {
  font-size: 26rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.req {
  color: #ff4d4f;
}
.input {
  height: 72rpx;
  font-size: 32rpx;
  color: #1f2329;
  font-weight: 500;
  border: 1rpx solid #e0e3e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #f9fafb;
}
.ph {
  color: #b0b6c0;
  font-weight: 400;
}
.picker {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  color: #1f2329;
  font-weight: 500;
}
.picker text:first-child {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker.is-ph text:first-child {
  color: #b0b6c0;
  font-weight: 400;
}
.arrow {
  margin-left: 16rpx;
  color: #c9cdd4;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}
.tag-input-row {
  display: flex;
  gap: 16rpx;
}
.tag-input {
  flex: 1;
}
.tag-add {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  background: #2b6de0;
  color: #ffffff;
  border-radius: 12rpx;
  text-align: center;
}
.tag-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  background: #eef4ff;
  color: #2b6de0;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}
.tag-x {
  opacity: 0.7;
}
.assignee-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.assignee {
  background: #f5f7fa;
  border: 2rpx solid #d8dce3;
  color: #5c6470;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
.assignee.on {
  background: #eef4ff;
  border-color: #2b6de0;
  color: #2b6de0;
  font-weight: 600;
}
.hint {
  font-size: 24rpx;
  color: #b0b6c0;
}
.textarea {
  width: 100%;
  height: 180rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1f2329;
  border: 1rpx solid #e0e3e8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f9fafb;
}
