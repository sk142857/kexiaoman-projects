<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="任务打卡"
      left-arrow="{{true}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y class="lp-scroll">
    <view class="page">
  <view class="card">
    <view class="task-title">{{taskTitle}}</view>

    <view class="field">
      <view class="label">打卡日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="picker">{{date}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">打卡备注</view>
      <textarea class="textarea" placeholder="今天完成了什么？" value="{{note}}" bindinput="onNote" />
    </view>

    <view class="field">
      <view class="label">打卡图片（最多9张）</view>
      <view class="img-grid">
        <image wx:for="{{images}}" wx:key="index" class="img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="removeImage" />
        <view wx:if="{{images.length < 9}}" class="img add" bindtap="addImages">＋</view>
      </view>
    </view>
  </view>
  </view>
</scroll-view>

  <view class="lp-actions">
    <t-button theme="primary" variant="base" block bindtap="onSubmit" loading="{{submitting}}">打卡</t-button>
  </view>
</view>
