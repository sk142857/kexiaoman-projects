.page {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
}
.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #8a919f;
  margin-bottom: 16rpx;
}
.input {
  font-size: 30rpx;
  color: #1f2329;
}
.picker {
  font-size: 30rpx;
  color: #1f2329;
}
.picker.ph {
  color: #c0c6cf;
}
.genders {
  display: flex;
  gap: 20rpx;
}
.gender {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  background: #f5f7fa;
  color: #1f2329;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gender.active {
  background: #2b6de0;
  color: #fff;
}
.preview {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8a919f;
  background: #f7faff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.preview-strong {
  color: #2b6de0;
  font-weight: 600;
  font-size: 30rpx;
}
.save-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #2b6de0;
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-btn.disabled {
  opacity: 0.6;
}
