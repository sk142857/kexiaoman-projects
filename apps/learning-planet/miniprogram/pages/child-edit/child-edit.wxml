<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="{{mode === 'edit' ? '编辑孩子' : '添加孩子'}}"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y class="lp-scroll">
    <view class="page">
      <view class="form-card">
        <view class="field">
          <text class="label">孩子姓名</text>
          <input class="input" value="{{form.child_name}}" bindinput="onName" placeholder="请输入孩子姓名" maxlength="20" />
        </view>

        <view class="field">
          <text class="label">性别</text>
          <view class="genders">
            <view class="gender {{form.gender === 0 ? 'active' : ''}}" data-v="0" bindtap="onGender">未知</view>
            <view class="gender {{form.gender === 1 ? 'active' : ''}}" data-v="1" bindtap="onGender">男</view>
            <view class="gender {{form.gender === 2 ? 'active' : ''}}" data-v="2" bindtap="onGender">女</view>
          </view>
        </view>

        <view class="field">
          <text class="label">出生年月</text>
          <picker mode="date" fields="month" value="{{form.birth_date}}" end="{{today}}" bindchange="onBirth">
            <view class="picker {{form.birth_date ? '' : 'ph'}}">{{form.birth_date || '请选择出生年月'}}</view>
          </picker>
        </view>

        <view class="field">
          <text class="label">学校名称</text>
          <input class="input" value="{{form.school_name}}" bindinput="onSchool" placeholder="请输入学校名称" maxlength="32" />
        </view>

        <view class="field">
          <text class="label">年级</text>
          <picker range="{{grades}}" range-key="label" value="{{gradeIndex}}" bindchange="onGrade">
            <view class="picker {{gradeIndex >= 0 ? '' : 'ph'}}">{{gradeIndex >= 0 ? grades[gradeIndex].label : '请选择年级'}}</view>
          </picker>
        </view>

        <view class="field">
          <text class="label">班级</text>
          <picker range="{{classes}}" range-key="label" value="{{classIndex}}" bindchange="onClass">
            <view class="picker {{classIndex >= 0 ? '' : 'ph'}}">{{classIndex >= 0 ? classes[classIndex].label : '请选择班级（1-35）'}}</view>
          </picker>
        </view>

        <view class="preview" wx:if="{{gradeIndex >= 0 && classIndex >= 0}}">
          班级展示：<text class="preview-strong">{{previewText}}</text>
        </view>
      </view>

      <view class="save-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">{{submitting ? '保存中...' : (mode === 'edit' ? '保存' : '添加孩子')}}</view>
    </view>
  </scroll-view>
</view>
