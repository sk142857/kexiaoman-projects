<view class="lp-page">
  <view class="block">
    <t-navbar
      t-class-placeholder="t-navbar-placeholder"
      t-class-content="t-navbar-content"
      title="孩子档案"
      placeholder="{{true}}"
    />
  </view>
  <scroll-view scroll-y class="lp-scroll">
    <view class="page">
      <t-empty wx:if="{{!loading && children.length === 0}}" description="还没有孩子档案，点击下方按钮添加" />

      <view wx:for="{{children}}" wx:key="child_id" class="child-card">
        <view class="child-top" bindtap="goEdit" data-id="{{item.child_id}}">
          <view class="child-avatar">{{item.avatarChar}}</view>
          <view class="child-info">
            <view class="child-name-row">
              <text class="child-name">{{item.child_name}}</text>
              <text class="child-gender">{{item.genderText}}</text>
            </view>
            <view class="child-meta">{{item.gradeText || '未设置年级'}} · {{item.school_name || '未填写学校'}}</view>
            <view class="child-meta">出生：{{item.birth_date || '未填写'}}</view>
          </view>
          <text class="child-arrow">›</text>
        </view>

        <view class="child-code">
          <view class="child-code-label">学生邀请码</view>
          <view class="child-code-row">
            <text class="child-code-value {{item.invite_status === 'available' ? '' : 'off'}}">{{item.invite_code || '--'}}</text>
            <view class="child-code-actions">
              <view class="child-code-btn" bindtap="onCopy" data-code="{{item.invite_code}}">复制</view>
              <view class="child-code-btn" bindtap="onRegen" data-id="{{item.child_id}}" data-name="{{item.child_name}}">重生成</view>
              <view class="child-code-btn danger" bindtap="onDelete" data-id="{{item.child_id}}" data-name="{{item.child_name}}">删除</view>
            </view>
          </view>
          <view class="child-code-tip">
            {{item.invite_status === 'available' ? '将此码告知孩子，孩子在小程序选择「我是学生」输入绑定' : '此码已失效/已绑定，可重新生成'}}
          </view>
        </view>
      </view>

      <view class="add-btn" bindtap="goAdd">＋ 添加孩子</view>
      <view class="foot">孩子档案由主家长维护，家属仅有查看权限</view>
    </view>
  </scroll-view>
</view>
