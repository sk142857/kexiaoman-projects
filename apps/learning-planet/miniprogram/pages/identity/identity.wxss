.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(env(safe-area-inset-top) + 100rpx) 64rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eaf2ff 0%, #f5f7fa 40%);
}
.logo {
  font-size: 100rpx;
}
.title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
}
.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a919f;
  text-align: center;
}
.cards {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.card {
  width: 100%;
  padding: 32rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.06);
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
.card--active {
  border-color: #2b6de0;
}
.card-emoji {
  font-size: 52rpx;
}
.card-name {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}
.card-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8a919f;
  line-height: 1.5;
}
.card--parent .card-name { color: #2b6de0; }
.card--student .card-name { color: #52c41a; }
.card--family .card-name { color: #fa8c16; }
.locked {
  margin-top: 48rpx;
  width: 100%;
  text-align: center;
}
.locked-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ff4d4f;
}
.locked-desc {
  margin-top: 12rpx;
  color: #8a919f;
  font-size: 26rpx;
}
.rebind-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff8c1a;
}
.code-box {
  width: 100%;
  margin-top: 40rpx;
}
.input {
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  font-weight: 600;
  color: #2b6de0;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
}
.ph {
  color: #c0c6cf;
  letter-spacing: 0;
  font-weight: 400;
  font-size: 30rpx;
}
.error {
  margin-top: 16rpx;
  color: #ff4d4f;
  font-size: 26rpx;
  text-align: center;
}
.btn {
  margin-top: 48rpx;
}
.tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c0;
}
.back {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2b6de0;
}
